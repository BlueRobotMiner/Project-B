  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=120%><b>PUBLISHER</b></size>\r\nCyan Circuit Games\r\n\r\n<size=120%><b>GAME
    DESIGN & PROGRAMMING</b></size>\r\nZachary Ziegler\r\n\r\n<size=120%><b>3D MODELS
    & TEXTURES</b></size>\r\nPumpkin Monster \u2014 woxec\r\nCursed Tree (CrackedTree)
    \u2014 Aliosa\r\nAdventure Character (Man_03) \u2014 Maksim Bugrimov\r\nHalloween
    Pumpkins & Props \u2014 Lumo-Art 3D & Robot Skeleton\r\nMonsterMutant 7 \u2014
    Panchenko Lyudmila\r\nDigital Camera \u2014 AK Studio Art\r\nStreet Lamps \u2014
    SpaceZeta\r\nFlashlight (Flashlight Gold) \u2014 RRFreelance\r\nHelicopter \u2014
    Duane's Mod\r\nGas Tank (Free Industrial Models) \u2014 Made For Games\r\nKeys
    (Simple Key 02) \u2014 Gabies Assets\r\nCobwebs \u2014 PolyOne\r\nGround Textures
    \u2014 ADG Textures and Yughues Free Ground Materials\r\n\r\n<size=120%><b>ENVIRONMENT</b></size>\r\nSkybox
    \u2014 AllSkyFree (Cold Night)\r\n\r\n<size=120%><b>ANIMATIONS</b></size>\r\nMixamo\r\n\r\n<size=120%><b>MUSIC</b></size>\r\nMain
    Menu \u2014 \"Scary Music Box\" \u2014 universfield\r\nExploration \u2014 \"Horror
    Background Atmosphere\" (3 versions) \u2014 universfield\r\nExploration \u2014
    \"Eerie Suspense Atmosphere\" \u2014 universfield\r\nSafe Rooms \u2014 \"Dreams
    of Recovery,\" \"Eastward Bound,\" \"Fountain of Healing,\" \"Is Anywhere Safe,\"
    \"Rest For A While,\" \"Revive,\" \"What's That Doing Here\" \u2014 juanjo_sound\r\n\r\n<size=120%><b>SOUND
    EFFECTS</b></size>\r\nMonster Growls \u2014 dragon-studio (5 sounds) and mollyroselee\r\nFlashlight
    Switch \u2014 freesound_community\r\nCamera Shutter & Flash \u2014 [uploader]\r\nItem
    Equip (Pickup) \u2014 freesound_community\r\nButton Click \u2014 freesound_community\r\nFootsteps
    \u2014 freesound_community and [other uploader]\r\nOut of Breath \u2014 voicebosch\r\n3
    Steps Sci-Fi Sound Library \u2014 Team Impulse Impact\r\n\r\n<size=120%><b>UI
    & FONTS</b></size>\r\nButton Set \u2014 TWD Free Button Set\r\nIcons \u2014 Rasterloom
    Free Icon Sampler\r\nFont \u2014 LiberationSans (SIL Open Font License)\r\n\r\n<size=120%><b>ENGINE</b></size>\r\nBuilt
    with Unity\r"
  m_isRightToLeft: 0
